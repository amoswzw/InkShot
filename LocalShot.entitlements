<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires App Sandbox. With it, `Process` calls to
	     /usr/sbin/screencapture are blocked — that's why capture is being
	     migrated to ScreenCaptureKit (region capture & recording still on
	     the legacy binary: don't ship a Release/sandboxed build yet). -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- Saving captures into a user-chosen folder (save panel / picker). -->
	<key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>

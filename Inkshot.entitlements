<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires App Sandbox. All capture and recording use
	     ScreenCaptureKit, which works inside it (no external tools). -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- Saving captures into a user-chosen folder (save panel / picker). -->
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- Keep access to that folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key><true/>
	<!-- Default save folder until one is picked: ~/Pictures. The Desktop has no
	     sandbox entitlement, so it can't be the default here. -->
	<key>com.apple.security.assets.pictures.read-write</key><true/>
</dict>
</plist>
